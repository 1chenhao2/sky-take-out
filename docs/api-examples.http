@baseUrl = http://localhost:8080
@adminToken = replace-with-admin-token
@userToken = replace-with-user-token

### 管理员登录
POST {{baseUrl}}/admin/employee/login
Content-Type: application/json

{"username": "admin", "password": "123456"}

### 查询营业状态
GET {{baseUrl}}/user/shop/status

### 管理端智能对话
POST {{baseUrl}}/admin/ai/chat
Content-Type: application/json
Token: {{adminToken}}

{"message": "分析最近 7 天的经营数据", "sessionId": "admin-session-1"}

### 用户端智能对话
POST {{baseUrl}}/user/ai/chat
Content-Type: application/json
Authentication: {{userToken}}

{"message": "推荐几道正在售卖的菜品", "sessionId": "user-session-1"}

### 清除管理端会话
DELETE {{baseUrl}}/admin/ai/session/admin-session-1
Token: {{adminToken}}
